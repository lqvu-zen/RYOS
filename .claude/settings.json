      "Bash(git tag -l*)",
      "Bash(git tag --list*)",
      "Bash(git branch --show-current)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push)",
      "Bash(git push origin *)",
      "Bash(git push -u origin *)",
      "Bash(git mv docs/plans/*)",
      "Bash(gh run list*)",
